{
	admin off
	auto_https off
	frankenphp
	servers {
		trusted_proxies static private_ranges
		client_ip_headers X-Forwarded-For X-Real-IP
	}
	log default {
		output stdout
		format json
		level INFO
	}
}

:{$PORT:8080} {
	root * /app/public
	encode zstd br gzip

	@immutable path /build/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	header {
		-Server
		-X-Powered-By
	}

	php_server
}
